{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/camerontjs-dot/proposition-authoring/schema/gates/1.0.0-rc.3/evidence-gate-output.schema.json",
  "title": "EvidenceGate V1 output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "implementation_identity",
    "evidence_world_id",
    "source_count",
    "sources",
    "corpus",
    "authority",
    "output_sha256"
  ],
  "properties": {
    "schema": {
      "const": "evidence-gate-output-v1"
    },
    "version": {
      "const": "1.0.0-rc.3"
    },
    "implementation_identity": {
      "type": "string",
      "minLength": 1
    },
    "evidence_world_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_world",
        "scope",
        "completeness",
        "known_gaps"
      ],
      "properties": {
        "verification_world": {
          "$ref": "#/$defs/observationNoSource"
        },
        "scope": {
          "$ref": "#/$defs/observationNoSource"
        },
        "completeness": {
          "$ref": "#/$defs/observationNoSource"
        },
        "known_gaps": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "values",
                "basis"
              ],
              "properties": {
                "state": {
                  "const": "unknown"
                },
                "values": {
                  "type": "array",
                  "maxItems": 0
                },
                "basis": {
                  "$ref": "#/$defs/basisNoSource"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "values",
                "basis"
              ],
              "properties": {
                "state": {
                  "const": "declared_none"
                },
                "values": {
                  "type": "array",
                  "maxItems": 0
                },
                "basis": {
                  "$ref": "#/$defs/basisNoSource"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "values",
                "basis"
              ],
              "properties": {
                "state": {
                  "const": "declared_some"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "basis": {
                  "$ref": "#/$defs/basisNoSource"
                }
              }
            }
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standardizes_evidence_identity",
        "standardizes_source_provenance",
        "standardizes_evidence_classification",
        "retrieval_authority",
        "evidence_relation_authority",
        "decision_authority",
        "authorization_authority"
      ],
      "properties": {
        "standardizes_evidence_identity": {
          "const": true
        },
        "standardizes_source_provenance": {
          "const": true
        },
        "standardizes_evidence_classification": {
          "const": true
        },
        "retrieval_authority": {
          "const": false
        },
        "evidence_relation_authority": {
          "const": false
        },
        "decision_authority": {
          "const": false
        },
        "authorization_authority": {
          "const": false
        }
      }
    },
    "output_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "basisNoSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "basisWithSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail",
        "source_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observationNoSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value",
            "basis"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "string"
            },
            "basis": {
              "$ref": "#/$defs/basisNoSource"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value",
            "basis"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            },
            "basis": {
              "$ref": "#/$defs/basisNoSource"
            }
          }
        }
      ]
    },
    "observationWithSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value",
            "basis"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "string"
            },
            "basis": {
              "$ref": "#/$defs/basisWithSource"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value",
            "basis"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            },
            "basis": {
              "$ref": "#/$defs/basisWithSource"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "representation_id",
        "media_type",
        "content_sha256",
        "provenance",
        "classification",
        "coverage"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_origin",
            "issuer",
            "source_role",
            "source_authority_basis"
          ],
          "properties": {
            "source_origin": {
              "$ref": "#/$defs/sourceOrigin"
            },
            "issuer": {
              "$ref": "#/$defs/observationWithSource"
            },
            "source_role": {
              "$ref": "#/$defs/observationWithSource"
            },
            "source_authority_basis": {
              "$ref": "#/$defs/observationWithSource"
            }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_type",
            "evidence_form"
          ],
          "properties": {
            "document_type": {
              "$ref": "#/$defs/observationWithSource"
            },
            "evidence_form": {
              "$ref": "#/$defs/observationWithSource"
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temporal",
            "jurisdiction",
            "version",
            "currency"
          ],
          "properties": {
            "temporal": {
              "$ref": "#/$defs/observationWithSource"
            },
            "jurisdiction": {
              "$ref": "#/$defs/observationWithSource"
            },
            "version": {
              "$ref": "#/$defs/observationWithSource"
            },
            "currency": {
              "$ref": "#/$defs/observationWithSource"
            }
          }
        },
        "representation_id": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceOrigin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "origin_type",
            "locator",
            "basis"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "origin_type": {
              "type": "null"
            },
            "locator": {
              "type": "null"
            },
            "basis": {
              "$ref": "#/$defs/basisWithSource"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "origin_type",
            "locator",
            "basis"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "origin_type": {
              "enum": [
                "official_database",
                "official_document",
                "official_website",
                "publisher_document",
                "organization_record",
                "repository",
                "user_supplied",
                "local_artifact",
                "other"
              ]
            },
            "locator": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/sourceLocator"
                }
              ]
            },
            "basis": {
              "$ref": "#/$defs/basisWithSource"
            }
          }
        }
      ]
    },
    "sourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "web_uri"
            },
            "value": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "doi",
                "registry_identifier",
                "repository_reference",
                "file_reference",
                "other"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
