{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/camerontjs-dot/proposition-authoring/schema/gates/1.0.0-rc.2/standardization-receipt.schema.json",
  "title": "Paired Gates V1 standardization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "root_id",
    "evidence_world_id",
    "claim_gate_output_sha256",
    "evidence_gate_output_sha256",
    "contract_a_state",
    "contract_a_handoff_sha256",
    "downstream_authority",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "paired-gates-standardization-receipt-v1"
    },
    "version": {
      "const": "1.0.0-rc.2"
    },
    "root_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_gate_output_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_gate_output_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "contract_a_state": {
      "enum": [
        "present",
        "absent"
      ]
    },
    "contract_a_handoff_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "downstream_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_bundler_may_consume_contract_a",
        "gate_metadata_is_retrieval_instruction",
        "gate_metadata_is_cal_verdict"
      ],
      "properties": {
        "evidence_bundler_may_consume_contract_a": {
          "type": "boolean"
        },
        "gate_metadata_is_retrieval_instruction": {
          "const": false
        },
        "gate_metadata_is_cal_verdict": {
          "const": false
        }
      }
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_world_id": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_a_state": {
            "const": "present"
          }
        }
      },
      "then": {
        "properties": {
          "contract_a_handoff_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract_a_state": {
            "const": "absent"
          }
        }
      },
      "then": {
        "properties": {
          "contract_a_handoff_sha256": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
