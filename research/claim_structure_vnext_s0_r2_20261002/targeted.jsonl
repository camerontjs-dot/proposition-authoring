{"authorized_context": "", "context_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "decisive_fresh": true, "id": "U01", "provenance": "public_pre_existing", "root": "Venus is the third brightest object in the sky after the Sun and Moon.", "root_sha256": "690599e03b9688719fd8a35c23de40867b956f2cc25923a5e72c9c3b44477911", "source": {"end_character": 6325, "snapshot_html_sha256": "e35adba2a9b3c9d5d728340a4aa6e33e166a02e10769f51d19268bfe0fc9818b", "snapshot_text_sha256": "771243d0385bc3081c84d3693bfc8e63bcff1202f647cd6fd83ac2bd1ff5a118", "start_character": 6255, "url": "https://science.nasa.gov/venus/venus-facts/"}}
{"authorized_context": "", "context_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "decisive_fresh": true, "id": "U02", "provenance": "public_pre_existing", "root": "Earth's axis of rotation is tilted 23.4 degrees with respect to the plane of Earth's orbit around the Sun.", "root_sha256": "e5769d302babba34928ce7c6862c1e37d6db9bc149650680a2a26bd6516d7377", "source": {"end_character": 8346, "snapshot_html_sha256": "5588df813e7e3eba67479699b550d1c3b19434903dcf70979d70c149edf6577f", "snapshot_text_sha256": "8def286d672511c14860e6dfb22ff0ed1fdfef7beaa58d817df112799859e17b", "start_character": 8240, "url": "https://science.nasa.gov/earth/facts/"}}
{"authorized_context": "", "context_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "decisive_fresh": true, "id": "U03", "provenance": "public_pre_existing", "root": "With an equatorial diameter of 7,926 miles (12,756 kilometers), Earth is the biggest of the terrestrial planets and the fifth largest planet in our solar system.", "root_sha256": "3fcfacdcf5322c069859378dcf4e1e0258d645ed14f76dc22ddc567bdee00cdc", "source": {"end_character": 7426, "snapshot_html_sha256": "5588df813e7e3eba67479699b550d1c3b19434903dcf70979d70c149edf6577f", "snapshot_text_sha256": "8def286d672511c14860e6dfb22ff0ed1fdfef7beaa58d817df112799859e17b", "start_character": 7265, "url": "https://science.nasa.gov/earth/facts/"}}
{"authorized_context": "The rings and they refer to the rings of Jupiter.", "context_sha256": "185f3570498eb3358e9771e00f1f418ab4fe16a950362fcaf980eba7ece69a77", "decisive_fresh": true, "id": "U04", "provenance": "public_pre_existing", "root": "The rings are composed of small, dark particles, and they are difficult to see except when backlit by the Sun.", "root_sha256": "3d9d6fe8438551988e4870217f65dafb7fd2c6c58382fc6c82fa97b77c9f5b6d", "source": {"end_character": 9800, "snapshot_html_sha256": "34c01392ea60bd380654504b44e3d87b18a8a83577beb336ad378b65011bf4ef", "snapshot_text_sha256": "ce028edb22c787544ca81e773d5c54751a0c927f1f86f9d1f79bd1cd625ebcdd", "start_character": 9690, "url": "https://science.nasa.gov/jupiter/jupiter-facts/"}}
{"authorized_context": "The resulting chunks are chunks displaced by a collision involving Earth. Our Moon is the Moon of Earth.", "context_sha256": "fceaaad69d253887dd32809e96980a9fd85d23efad329b64c3f6416f70187743", "decisive_fresh": true, "id": "U05", "provenance": "public_pre_existing", "root": "The resulting chunks clumped together and formed our Moon.", "root_sha256": "eb3e6760adf9e6f16b85626f36f6cb06965dd56684613d4277e8d0359a042d52", "source": {"end_character": 9692, "snapshot_html_sha256": "5588df813e7e3eba67479699b550d1c3b19434903dcf70979d70c149edf6577f", "snapshot_text_sha256": "8def286d672511c14860e6dfb22ff0ed1fdfef7beaa58d817df112799859e17b", "start_character": 9634, "url": "https://science.nasa.gov/earth/facts/"}}
{"authorized_context": "its refers to Jupiter.", "context_sha256": "e89003b56307646de25d767012f3940667a4065a189a04f7ba7f44db9a77cc70", "decisive_fresh": true, "id": "U06", "provenance": "public_pre_existing", "root": "Jupiter's fast rotation – spinning once every 10 hours – creates strong jet streams, separating its clouds into dark belts and bright zones across long stretches.", "root_sha256": "c6365971593b3d4045dda9f1351b05ed7b6540f1312506d0a10646f20a51cd65", "source": {"end_character": 13057, "snapshot_html_sha256": "34c01392ea60bd380654504b44e3d87b18a8a83577beb336ad378b65011bf4ef", "snapshot_text_sha256": "ce028edb22c787544ca81e773d5c54751a0c927f1f86f9d1f79bd1cd625ebcdd", "start_character": 12895, "url": "https://science.nasa.gov/jupiter/jupiter-facts/"}}
{"authorized_context": "the core is the core of Jupiter.", "context_sha256": "ba1326e58968c41fd2bd0c8c26a92deaf7337590639db4d1abd4693eb3c9634c", "decisive_fresh": true, "id": "U07", "provenance": "public_pre_existing", "root": "NASA’s Juno spacecraft, measuring Jupiter’s gravity and magnetic field, found data suggesting the core is much larger than expected, and not solid.", "root_sha256": "1489ba0cd981a25057b60bfb6444850e8a475ecc2eb6b5075e22bf66996ea035", "source": {"end_character": 11750, "snapshot_html_sha256": "34c01392ea60bd380654504b44e3d87b18a8a83577beb336ad378b65011bf4ef", "snapshot_text_sha256": "ce028edb22c787544ca81e773d5c54751a0c927f1f86f9d1f79bd1cd625ebcdd", "start_character": 11603, "url": "https://science.nasa.gov/jupiter/jupiter-facts/"}}
{"authorized_context": "", "context_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "decisive_fresh": true, "id": "U08", "provenance": "public_pre_existing", "root": "NASA missions have found lots of evidence that Mars was much wetter and warmer, with a thicker atmosphere, billions of years ago.", "root_sha256": "919a97c966b5c3168325033d0dbd9a8d05cdc38a3e52f9abc0173bdea5b4a898", "source": {"end_character": 6235, "snapshot_html_sha256": "2f5630fc6163dedf09984e8f8a417d9ba8375662727d7e83a3302de5c1a11471", "snapshot_text_sha256": "1b99b4447e184a0323f35c4061c29a13b28ee7698ec1f7b557033e8ed4714bc3", "start_character": 6106, "url": "https://science.nasa.gov/mars/facts/"}}
{"authorized_context": "we denotes the hypothetical observers; they denotes Venus and Earth.", "context_sha256": "ff318702503a9a5f3f48692b7b73fad33a6148eeacf81b9ea9add3c50a1ccb75", "decisive_fresh": true, "id": "U09", "provenance": "public_pre_existing", "root": "If we could slice Venus and Earth in half, pole to pole, and place them side by side, they would look remarkably similar.", "root_sha256": "0e547bf6789a467d1041a7345bf601930b1f1d7374086ff5debed5e3ca5a7f30", "source": {"end_character": 15843, "snapshot_html_sha256": "e35adba2a9b3c9d5d728340a4aa6e33e166a02e10769f51d19268bfe0fc9818b", "snapshot_text_sha256": "771243d0385bc3081c84d3693bfc8e63bcff1202f647cd6fd83ac2bd1ff5a118", "start_character": 15722, "url": "https://science.nasa.gov/venus/venus-facts/"}}
{"authorized_context": "it denotes Phobos; the Red Planet denotes Mars.", "context_sha256": "d18fc2952a35839f72597c5e00c6cb75b2eb16125c1463fc8057ef4e64a440ee", "decisive_fresh": true, "id": "U10", "provenance": "public_pre_existing", "root": "However, in 50 million years when Phobos crashes into Mars or breaks apart, it could create a dusty ring around the Red Planet.", "root_sha256": "a724832f55a610f35fe89cf48787c82bc68c5749b161bbcd080f2af82e5b6f73", "source": {"end_character": 9800, "snapshot_html_sha256": "2f5630fc6163dedf09984e8f8a417d9ba8375662727d7e83a3302de5c1a11471", "snapshot_text_sha256": "1b99b4447e184a0323f35c4061c29a13b28ee7698ec1f7b557033e8ed4714bc3", "start_character": 9673, "url": "https://science.nasa.gov/mars/facts/"}}
{"authorized_context": "The innermost layer denotes the innermost cloud layer of Jupiter.", "context_sha256": "50f154b3e0bb0168de882241a76dc7f86fd557d71592eb9617f905dbd3f20d34", "decisive_fresh": true, "id": "U11", "provenance": "public_pre_existing", "root": "The innermost layer may be made of water ice and vapor.", "root_sha256": "6d82157e7637e784e915be70112054ac439496b37e9a6c66398032fd24084797", "source": {"end_character": 12741, "snapshot_html_sha256": "34c01392ea60bd380654504b44e3d87b18a8a83577beb336ad378b65011bf4ef", "snapshot_text_sha256": "ce028edb22c787544ca81e773d5c54751a0c927f1f86f9d1f79bd1cd625ebcdd", "start_character": 12686, "url": "https://science.nasa.gov/jupiter/jupiter-facts/"}}
{"authorized_context": "", "context_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "decisive_fresh": true, "id": "U12", "provenance": "public_pre_existing", "root": "Venus is similar in structure and size to Earth, and is sometimes called Earth's evil twin.", "root_sha256": "a6673da569bc2acbe20a6aac7df9e3b0d5dcbe7c554ea35704d2907bc01ab27e", "source": {"end_character": 6481, "snapshot_html_sha256": "e35adba2a9b3c9d5d728340a4aa6e33e166a02e10769f51d19268bfe0fc9818b", "snapshot_text_sha256": "771243d0385bc3081c84d3693bfc8e63bcff1202f647cd6fd83ac2bd1ff5a118", "start_character": 6390, "url": "https://science.nasa.gov/venus/venus-facts/"}}
{"authorized_context": "", "context_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "decisive_fresh": false, "id": "R01", "provenance": "public_replay_anchor", "root": "Venus spins slowly in the opposite direction from most planets.", "root_sha256": "323e22238933d2093dbf5f6e5c6fbbbc3da2ba44aba9f51cc86b1e50a268baa2", "source": {"end_character": 6389, "snapshot_html_sha256": "e35adba2a9b3c9d5d728340a4aa6e33e166a02e10769f51d19268bfe0fc9818b", "snapshot_text_sha256": "771243d0385bc3081c84d3693bfc8e63bcff1202f647cd6fd83ac2bd1ff5a118", "start_character": 6326, "url": "https://science.nasa.gov/venus/venus-facts/"}}
{"authorized_context": "It refers to Phobos; the planet refers to Mars.", "context_sha256": "60663d0e14857e11ebd283f2b9dcfab9227f005bd13949b9584e5d3424d7f6f3", "decisive_fresh": false, "id": "R02", "provenance": "public_replay_anchor", "root": "It is slowly moving towards Mars and will crash into the planet or break apart in about 50 million years.", "root_sha256": "2cd833ec7ac5c4c13b0d7eca370793e8c14622508c1921896ad929e858e3287e", "source": {"end_character": 9119, "snapshot_html_sha256": "2f5630fc6163dedf09984e8f8a417d9ba8375662727d7e83a3302de5c1a11471", "snapshot_text_sha256": "1b99b4447e184a0323f35c4061c29a13b28ee7698ec1f7b557033e8ed4714bc3", "start_character": 9014, "url": "https://science.nasa.gov/mars/facts/"}}
